{
  "name": "02_Backend",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "db:up": "docker compose -f db/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f db/docker-compose.yml --env-file .env down",
    "db:delete": "docker compose -f db/docker-compose.yml --env-file .env down -v"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.27.7",
    "haversine-distance": "^1.2.4",
    "hono": "^4.12.16",
    "pg": "^8.20.0",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0"
  }
}
