JWT_SECRET="SUPERSECRETJWTSECRET"
JWT_EXPIRATION_SECONDS=600

POSTGRES_USER=username
POSTGRES_PASSWORD=supersecretpgpw
POSTGRES_DB=myapp_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://username:supersecretpgpw@localhost:5432/myapp_db

INITIAL_ACCESS_CODE=1111-1111-1111

PORT=3000

# INTERNAL_HOST defines where bun serves the application. The backend should only be  
# exposed locally on the server, so that a web server like Caddy can handle certificate 
# verfication and redirect locally. For docker deployment, 0.0.0.0 can be used in
# combination with a localhost binding via docker compose, ie. 127.0.0.1:3000:3000.
INTERNAL_HOST=localhost
EXTERNAL_HOST=
SUPER_DANGEROUS_TURN_OFF_DEVICE_AUTH_FOR_TESTING=false
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
RESEND_API_KEY=

FROM_EMAIL=
FROM_EMAIL_NAME='Bsc Notification'

PUSH_PROVIDER=ntfy
PUSH_PROVIDER_URL=https://ntfy.sh

GITLAB_API_BASE_URL=
GITLAB_PROJECT_ID=
GITLAB_TOKEN=

SENSOR_NOTIFICATION_WINDOW_SECONDS=60

MAX_TRANSPORTS_PER_BATCH=20
MAX_TRANSPORT_SENDS_PER_SECOND=5
