# See /02_Backend/.env.example for the full configuration.

# Additionally, ensure the following is set:
# Ensure that the host is adjusted to `db` instead of `localhost` to point to the docker container.
POSTGRES_HOST=db
DATABASE_URL=postgresql://username:supersecretpgpw@db:5432/myapp_db

# Ensure that INTERNAL_HOST uses 0.0.0.0 so docker exposes the container to the host.
INTERNAL_HOST=0.0.0.0

