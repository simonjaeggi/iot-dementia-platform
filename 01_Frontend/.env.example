BACKEND_URL=http://localhost:3000
ALLOWED_HOSTS=bscraspi.local,bscraspi.burmese-economy.ts.net
# specifies after how much time a device should be labeled offline
VITE_DEVICE_TIMEOUT_SEC=30

# INTERNAL if vite should forward backend calls or EXTERNAL if api calls are handled by a reverse proxy
PROXY_MODE=EXTERNAL
